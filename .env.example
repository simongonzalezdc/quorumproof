# QuorumProof — all optional. Copy to .env only if you want to enable extras.
# Never commit a real .env.

# On-chain quorum registry (optional; needs CC3 testnet gas):
# QUORUMPROOF_REGISTRY_ADDRESS=0x...
# QUORUMPROOF_SUBMITTER_KEY=0x...

# Optional 4th LLM analyst (any OpenAI-compatible endpoint):
# QUORUMPROOF_LLM_URL=https://api.example.com/v1
# QUORUMPROOF_LLM_MODEL=...
# QUORUMPROOF_LLM_API_KEY=...
